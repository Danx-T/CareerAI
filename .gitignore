# ============================================
# CV Optimizer & Interview Coach — .gitignore
# ============================================

# ----- Environment & Secrets -----
.env
.env.local
.env.*.local

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ----- Database -----
*.db
*.sqlite
*.sqlite3

# ----- Uploaded Files -----
backend/uploads/*
!backend/uploads/.gitkeep

# ----- Node / Frontend -----
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
frontend/build/
frontend/.vite/

# ----- IDE / Editor -----
.vscode/settings.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Docker -----
# (docker-compose.yml is committed; ignore override files)
docker-compose.override.yml

# ----- Logs -----
logs/
*.log
